# =============================================================================
# Environment variables for the My Customs website
# -----------------------------------------------------------------------------
# Copy this file to ".env.local" and replace the placeholder values below.
#
#   cp .env.example .env.local      (macOS / Linux)
#   copy .env.example .env.local    (Windows)
#
# The real values for every variable are provided in the separate
# "MyCustoms-Credentials" document that was sent to you by email
# (see SETUP.md for details). Do NOT commit ".env.local" to version control.
# =============================================================================

# --- Sanity (CMS) ------------------------------------------------------------
# Public project identifiers (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional. Defaults to "2025-12-22" in code if not set.
# NEXT_PUBLIC_SANITY_API_VERSION="2025-12-22"

# Server-side Sanity API token with write access.
# Only required for running the data migration script in /scripts.
SANITY_API_TOKEN="your-sanity-api-token"

# Secret used to verify incoming Sanity webhooks (on-demand revalidation).
SANITY_WEBHOOK_SECRET="your-webhook-secret"

# --- Translation (optional) --------------------------------------------------
# URL of a LibreTranslate instance used by the translate helper.
# Leave the default unless you run your own LibreTranslate server.
LIBRETRANSLATE_URL="http://localhost:5000"

# --- Site / contact details --------------------------------------------------
SITE_URL="https://your-site-url.com"
REACH_OUT_EMAIL="sales@example.com"
REACH_OUT_PHONE="+31-1234-5678-90"

# --- SMTP (contact form e-mails) ---------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="My Customs Website"
# Address that receives submissions from the contact form.
CONTACT_FORM_RECIPIENT="your-inbox@example.com"

# --- Google reCAPTCHA v2 -----------------------------------------------------
# Public site key (safe to expose) and private secret key.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
